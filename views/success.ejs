<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Success - Alumni Connect</title>
    <meta name="robots" content="noindex">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='22' fill='%235865F2'/></svg>">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              linkedin: '#0a66c2',
              discord: '#5865F2',
              pageBg: '#f3f2ef',
              cardBorder: '#e0dfdc',
              textPrimary: '#191919',
              textSecondary: '#666666'
            }
          }
        }
      }
    </script>
</head>
<body class="bg-pageBg text-textPrimary min-h-screen flex items-center justify-center font-sans antialiased p-4 text-center">
    <div class="bg-white max-w-md w-full rounded-xl p-10 shadow-sm border border-cardBorder">
        <div class="w-16 h-16 mx-auto bg-green-50 text-green-600 rounded-full flex items-center justify-center mb-6 border border-green-100">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
        </div>
        <h1 class="text-2xl font-bold mb-2 text-textPrimary">LinkedIn Connected Successfully</h1>
        <p class="text-textSecondary text-sm mb-8">Your account is securely linked and your preferences have been saved.</p>
        <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 w-full">
            <p class="text-xs text-gray-500 mb-2 uppercase tracking-wider font-semibold">Return to Discord</p>
            <p class="text-sm text-gray-700">Run <code class="bg-gray-200 text-discord px-2 py-0.5 rounded font-mono font-medium">/my-profile</code> to view your setup.</p>
        </div>
    </div>
</body>
</html>
