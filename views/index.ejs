<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alumni Connect Bot</title>
    <meta name="description" content="Securely connect your LinkedIn account to the Alumni Connect Discord community.">
    <link rel="icon" href="/logo.png" type="image/png">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              linkedin: '#0a66c2',
              linkedinHover: '#004182',
              discord: '#5865F2',
              pageBg: '#F3F2EF',
              cardBorder: 'rgba(0,0,0,0.08)',
              cardBg: '#FFFFFF',
              textPrimary: 'rgba(0,0,0,0.9)',
              textSecondary: 'rgba(0,0,0,0.6)'
            },
            fontFamily: {
              sans: [
                '-apple-system', 'system-ui', 'BlinkMacSystemFont', '"Segoe UI"', 'Roboto', '"Helvetica Neue"', '"Fira Sans"', 'Ubuntu', 'Oxygen', '"Oxygen Sans"', 'Cantarell', '"Droid Sans"', '"Apple Color Emoji"', '"Segoe UI Emoji"', '"Segoe UI Symbol"', '"Lucida Grande"', 'Helvetica', 'Arial', 'sans-serif'
              ],
            }
          }
        }
      }
    </script>
</head>
<body class="bg-pageBg text-textPrimary min-h-screen flex items-center justify-center font-sans antialiased p-4">
    <div class="bg-cardBg max-w-md w-full rounded-lg p-8 border border-cardBorder">
        <div class="flex flex-col items-center mb-6">
            <img src="/logo.png" alt="TCET Logo" class="w-32 h-auto object-contain mb-6">
            <div class="flex justify-center space-x-4 items-center">
                <div class="w-12 h-12 rounded-lg bg-discord flex items-center justify-center shadow-sm">
                    <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 127.14 96.36"><path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.31,60,73.31,53s5-12.74,11.43-12.74S96.2,46,96.12,53,91.08,65.69,84.69,65.69Z"/></svg>
                </div>
                <div class="h-[2px] w-8 bg-gray-300"></div>
                <div class="w-12 h-12 rounded-lg bg-linkedin flex items-center justify-center shadow-sm">
                    <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                </div>
            </div>
        </div>
        <h1 class="text-2xl font-bold text-center mb-2 text-textPrimary">Alumni Connect</h1>
        <p class="text-center text-textSecondary mb-8 text-sm">Connect your LinkedIn account securely. Powered by Discord.</p>
        <div class="bg-blue-50 border border-blue-100 rounded-lg p-4 mb-6">
            <p class="text-center text-blue-900 text-sm">
                To get started, generate a secure connection link in Discord by typing <br> <code class="bg-blue-100 px-2 py-1 rounded font-mono font-medium mt-2 inline-block text-linkedin">/connect-linkedin</code>
            </p>
        </div>
        <div class="flex justify-center border-t border-gray-100 pt-4 space-x-6">
            <a href="/about" class="text-sm font-semibold text-textSecondary hover:text-linkedin transition-colors">About Us</a>
            <a href="/privacy" class="text-sm font-semibold text-textSecondary hover:text-linkedin transition-colors">Privacy Policy</a>
        </div>
    </div>
</body>
</html>
