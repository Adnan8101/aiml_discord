<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alumni Connect Bot</title>
    <meta name="description" content="Securely connect your LinkedIn account to the Alumni Connect Discord community.">
    <link rel="icon" href="/logo.png" type="image/png">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              linkedin: '#0a66c2',
              discord: '#5865F2',
              pageBg: '#f3f2ef',
              cardBorder: '#e0dfdc',
              textPrimary: '#191919',
              textSecondary: '#666666'
            }
          }
        }
      }
    </script>
</head>
<body class="bg-pageBg text-textPrimary min-h-screen flex items-center justify-center font-sans antialiased p-4">
    <div class="bg-white max-w-md w-full rounded-xl p-8 shadow-sm border border-cardBorder">
        <div class="flex justify-center mb-6 space-x-4 items-center">
            <div class="w-12 h-12 rounded-full shadow-sm overflow-hidden bg-white border border-gray-200">
                <img src="/logo.png" alt="TCET Logo" class="w-full h-full object-cover">
            </div>
            <div class="h-[2px] w-8 bg-gray-300"></div>
            <div class="w-12 h-12 rounded-lg bg-linkedin flex items-center justify-center shadow-sm">
                <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            </div>
        </div>
        <h1 class="text-2xl font-bold text-center mb-2 text-textPrimary">Alumni Connect</h1>
        <p class="text-center text-textSecondary mb-8 text-sm">Connect your LinkedIn account securely. Powered by Discord.</p>
        <div class="bg-blue-50 border border-blue-100 rounded-lg p-4 mb-6">
            <p class="text-center text-blue-900 text-sm">
                To get started, generate a secure connection link in Discord by typing <br> <code class="bg-blue-100 px-2 py-1 rounded font-mono font-medium mt-2 inline-block text-linkedin">/connect-linkedin</code>
            </p>
        </div>
        <div class="flex justify-center border-t border-gray-100 pt-4 space-x-6">
            <a href="/about" class="text-sm font-semibold text-textSecondary hover:text-linkedin transition-colors">About Us</a>
            <a href="/privacy" class="text-sm font-semibold text-textSecondary hover:text-linkedin transition-colors">Privacy Policy</a>
        </div>
    </div>
</body>
</html>
