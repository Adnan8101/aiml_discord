<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Consent - Alumni Connect</title>
    <meta name="robots" content="noindex">
    <link rel="icon" href="/logo.png" type="image/png">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              linkedin: '#0a66c2',
              pageBg: '#f3f2ef',
              cardBorder: '#e0dfdc',
              textPrimary: '#191919',
              textSecondary: '#666666'
            }
          }
        }
      }
    </script>
</head>
<body class="bg-pageBg text-textPrimary min-h-screen flex items-center justify-center font-sans antialiased p-4">
    <div class="bg-white max-w-md w-full rounded-xl p-8 shadow-sm border border-cardBorder">
        <h1 class="text-2xl font-bold mb-2">Almost Done!</h1>
        <p class="text-textSecondary text-sm mb-8">Please choose how you want to interact with the Alumni Directory.</p>
        <form action="/consent" method="POST" class="space-y-4">
            <input type="hidden" name="state" value="<%= state %>" />
            <label class="flex items-start space-x-3 cursor-pointer group p-4 border border-gray-200 rounded-lg hover:border-linkedin hover:bg-blue-50 transition-colors">
                <div class="flex-shrink-0 mt-0.5">
                    <input type="checkbox" name="directory_visible" class="w-5 h-5 rounded border-gray-300 text-linkedin focus:ring-linkedin">
                </div>
                <div>
                    <span class="block font-semibold mb-1 text-textPrimary group-hover:text-linkedin transition-colors">Show me in Alumni Directory</span>
                    <span class="block text-sm text-textSecondary">Allow other verified server members to view your name, headline, and skills via bot commands.</span>
                </div>
            </label>
            <label class="flex items-start space-x-3 cursor-pointer group p-4 border border-gray-200 rounded-lg hover:border-linkedin hover:bg-blue-50 transition-colors">
                <div class="flex-shrink-0 mt-0.5">
                    <input type="checkbox" name="open_to_connect" class="w-5 h-5 rounded border-gray-300 text-linkedin focus:ring-linkedin">
                </div>
                <div>
                    <span class="block font-semibold mb-1 text-textPrimary group-hover:text-linkedin transition-colors">Allow Networking Requests</span>
                    <span class="block text-sm text-textSecondary">Allow members to send connection requests. Your public LinkedIn URL will only be revealed if you accept.</span>
                </div>
            </label>
            <button type="submit" class="w-full mt-6 bg-linkedin hover:bg-blue-800 text-white font-semibold py-3 px-4 rounded-full transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-linkedin">
                Complete Setup
            </button>
        </form>
    </div>
</body>
</html>
